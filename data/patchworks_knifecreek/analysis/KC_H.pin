/*
 * Knife Creek Patchworks control surface.
 *
 * This is a structural pin, not a legal-compliance model. It records the
 * horizon, topology, patch accounts and scenario entry points for the H matrix.
 */
int periods = 10;
Horizon.setHorizon(periods, 10);

boolean useRoutes = false;
boolean usePatches = true;

String tracks_path_prefix = "../tracks/H/";
String scripts_path_prefix = "./";
String data_path_prefix = "../";

blocks = tracks_path_prefix+"blocks.csv";
curves = tracks_path_prefix+"curves.csv";
features = tracks_path_prefix+"features.csv";
products = tracks_path_prefix+"products.csv";
tracknames = tracks_path_prefix+"tracknames.csv";
treatments = tracks_path_prefix+"treatments.csv";
accounts = tracks_path_prefix+"accounts.csv";
stratas = tracks_path_prefix+"strata.csv";

block_shape = data_path_prefix+"spatial/fragments.shp";
block_key = "RES_KEY";

int Patchworks_TargetInit() {
   control.inputTopology(data_path_prefix+"spatial/topo_fragments.csv", 20d);
   if (usePatches) {
      control.addPatchTarget("feature.area.managed.total", "patch.managed.0_1", 0.0, 1.0);
      control.addPatchTarget("feature.area.managed.total", "patch.managed.1_5", 1.0, 5.0);
      control.addPatchTarget("feature.area.managed.total", "patch.managed.5_25", 5.0, 25.0);
      control.addPatchTarget("feature.area.managed.total", "patch.managed.25_50", 25.0, 50.0);
      control.addPatchTarget("feature.area.managed.total", "patch.managed.50plus", 50.0, 99999.0);
   }

   control.inputTopology(data_path_prefix+"spatial/topo_fragments.csv", 100d);

   source(scripts_path_prefix+"RATIO_ACCOUNTS.bsh");
   return 1;
}

int PatchWorks_Init() {
   classic_GUI(control);
   return 1;
}
